# Скопируйте в .env и поправьте, что нужно. Пустая строка — значение по умолчанию.

# Хоумсерверы, к которым мост согласен ходить, через запятую.
# Для matrix.org нужны оба адреса: вход идёт через matrix.org, а всё остальное — через
# matrix-client.matrix.org. Для своего сервера обычно тоже два: example.org,matrix.example.org
# `*` — любой публичный сервер; тогда закройте мост ключами ниже.
ALLOWED_UPSTREAMS=matrix.org,matrix-client.matrix.org

# Кого мост слушает. Пусто — всех, кто знает его адрес.
# Ключ устройства — в приложении: Настройки → Соединение → «Ключ этого устройства».
# Несколько — через запятую.
ALLOWED_PUBKEYS=

# Relay, через которые мост и приложение находят друг друга. Пусто — те же три, что берёт
# приложение, когда его поле пустое. Меняете здесь — поменяйте и в приложении.
RELAY_LIST=

# Байт в минуту на одно устройство, в обе стороны. Пусто — 64 МиБ. Сверх — поток замедляется,
# а не рвётся.
STREAM_BYTES_PER_MIN=

# Какую версию образа брать: latest — стабильная, dev — самая свежая.
BRIDGE_TAG=latest
