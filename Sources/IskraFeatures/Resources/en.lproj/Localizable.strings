/* --- Getting your messages back ----------------------------------------------
   The screen between signing in and the conversations, and the strip that reminds
   you about it. The words are chosen so that nobody ever meets "verification",
   "cross-signing" or "secret storage". There is exactly one thing — a recovery
   code — and it behaves like a backup code from an authenticator app. */

/* While the SDK works out what this device knows. Seconds, but saying nothing is not an option. */
"recovery.preparing" = "One moment, looking through your messages";

/* Flow 1. The backup turns itself on, without asking, and the wait is a real one:
   the whole history goes up to the server. Promising "instant" would be a lie. */
"recovery.creating.title" = "Setting up your backup";
"recovery.creating.message" = "We’re putting your messages into a backup so you can read them from any device. This can take a minute.";

/* The button under the code. Skipping is allowed — but the strip in the chat list won’t let you forget. */

/* Flow 2. Two buttons of equal weight. Neither is "the main one": somebody who picks the
   picture check should not feel they picked the fallback. */
"recovery.new.title" = "Create a new code?";
"recovery.new.message" = "The old code stops working immediately, and there is no getting it back. If you have it written down somewhere, that copy becomes useless.";
