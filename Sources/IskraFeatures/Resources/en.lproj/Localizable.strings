/* --- Getting your messages back ----------------------------------------------
   The screen between signing in and the conversations, and the strip that reminds
   you about it. The words are chosen so that nobody ever meets "verification",
   "cross-signing" or "secret storage". There is exactly one thing — a recovery
   code — and it behaves like a backup code from an authenticator app. */

/* While the SDK works out what this device knows. Seconds, but saying nothing is not an option. */
"recovery.preparing" = "One moment, looking through your messages";

/* Flow 1. The backup turns itself on, without asking, and the wait is a real one:
   the whole history goes up to the server. Promising "instant" would be a lie. */
"recovery.creating.title" = "Setting up your backup";
"recovery.creating.message" = "We’re putting your messages into a backup so you can read them from any device. This can take a minute.";

/* The button under the code. Skipping is allowed — but the strip in the chat list won’t let you forget. */

/* Flow 2. Two buttons of equal weight. Neither is "the main one": somebody who picks the
   picture check should not feel they picked the fallback. */
"recovery.new.title" = "Create a new code?";
"recovery.new.message" = "The old code stops working immediately, and there is no getting it back. If you have it written down somewhere, that copy becomes useless.";
"recovery.new.confirm" = "Create a new code";
"recovery.new.keepOld" = "Later — I’ll go and look for the old one";
"recovery.approve.title" = "Did you approve it?";
"recovery.approve.message" = "The reset has to be approved on your server’s page. If you did that, carry on — and your old messages are gone for good. If you changed your mind, nothing happens.";
"recovery.approve.confirm" = "Erase old messages for good";
"recovery.approve.cancel" = "I changed my mind";
"recovery.choose.title" = "Unlock your messages";
"recovery.choose.message" = "Your earlier messages are encrypted, and this device can’t open them yet. There are two ways — both of them work.";
"recovery.choose.haveCode" = "I have my recovery code";
"recovery.choose.otherDevice" = "Confirm from another device";
"recovery.choose.neither" = "I have neither";

/* Entering the code. The keyboard has no business helping here — this arrives by paste. */
"recovery.enter.title" = "Enter your recovery code";
"recovery.enter.message" = "The code we showed you when the backup was turned on.";
"recovery.enter.unlock" = "Unlock my messages";
"recovery.enter.lost" = "I can’t find my code";

/* Flow 3, the branch where another device exists. Losing the code is not a disaster, and the tone says so. */
"recovery.lost.title" = "Can’t find it?";
"recovery.lost.hasDevices" = "That’s all right. Confirm this device from a phone or computer where you’re already signed in, and we’ll give you a new code to replace the lost one.";

/* Flow 3, the branch where there is nothing else. Said plainly, without frightening anyone:
   losing your messages is bad, but being frightened and not knowing what to do is worse. */
"recovery.lost.alone.title" = "Let’s start fresh";
"recovery.lost.alone.message" = "Without the code and without another device, your old messages can’t come back — they stay encrypted for good. New messages will arrive as usual, and we’ll give you a new recovery code.";

/* The design note asks for this to be separated from a password reset explicitly, so that
   nobody — the developer included — confuses the two. A password opens the account, not the messages. */
"recovery.lost.alone.notPassword" = "Your account password has nothing to do with this: it opens your account, not your old messages.";
"recovery.lost.alone.start" = "Start fresh";

/* The server wants to see the person again before it allows the reset. */
"recovery.password.title" = "Enter your password";
"recovery.password.message" = "Your server is asking you to confirm it’s really you.";
"recovery.password.placeholder" = "Password";
"recovery.password.confirm" = "Confirm";

/* The strip in the chat list. It stays until the reason is gone: the code is shown once, and
   somebody who didn’t save it finds out six months later — unless they’re reminded. */
"recovery.banner.locked" = "Your old messages are locked";
"recovery.save.warning" = "If this code is lost and you have no other device, nobody can bring your old messages back — not us, not the server. They stay encrypted for good.";
"recovery.save.confirm" = "I’ve written the code down somewhere safe";
"recovery.lost.noAccess" = "I can’t get to that device";
"recovery.banner.hint" = "Opens recovery setup";
"recovery.close" = "Close";

