/* --- Getting your messages back ----------------------------------------------
   The screen between signing in and the conversations, and the strip that reminds
   you about it. The words are chosen so that nobody ever meets "verification",
   "cross-signing" or "secret storage". There is exactly one thing — a recovery
   code — and it behaves like a backup code from an authenticator app. */

/* While the SDK works out what this device knows. Seconds, but saying nothing is not an option. */
"recovery.preparing" = "Einen Moment, wir sehen Ihre Nachrichten durch";

/* Flow 1. The backup turns itself on, without asking, and the wait is a real one:
   the whole history goes up to the server. Promising "instant" would be a lie. */
"recovery.creating.title" = "Backup wird eingerichtet";
"recovery.creating.message" = "Wir legen Ihre Nachrichten in ein Backup, damit Sie sie auf jedem Gerät lesen können. Das kann eine Minute dauern.";

/* The button under the code. Skipping is allowed — but the strip in the chat list won’t let you forget. */

/* Flow 2. Two buttons of equal weight. Neither is "the main one": somebody who picks the
   picture check should not feel they picked the fallback. */
"recovery.new.title" = "Neuen Code erstellen?";
"recovery.new.message" = "Der alte Code funktioniert sofort nicht mehr, und er lässt sich nicht zurückholen. Wenn Sie ihn irgendwo aufgeschrieben haben, ist diese Notiz dann wertlos.";
"recovery.new.confirm" = "Neuen Code erstellen";
"recovery.new.keepOld" = "Später – ich suche den alten";
"recovery.approve.title" = "Haben Sie es bestätigt?";
"recovery.approve.message" = "Das Zurücksetzen muss auf der Seite Ihres Servers bestätigt werden. Wenn Sie das getan haben, machen Sie weiter – dann sind Ihre alten Nachrichten für immer weg. Wenn Sie es sich anders überlegt haben, passiert nichts.";
"recovery.approve.confirm" = "Alte Nachrichten endgültig löschen";
"recovery.approve.cancel" = "Ich habe es mir anders überlegt";
"recovery.choose.title" = "Entsperren Sie Ihre Nachrichten";
"recovery.choose.message" = "Ihre früheren Nachrichten sind verschlüsselt, und dieses Gerät kann sie noch nicht öffnen. Es gibt zwei Wege – beide funktionieren.";
"recovery.choose.haveCode" = "Ich habe meinen Wiederherstellungscode";
"recovery.choose.otherDevice" = "Von einem anderen Gerät bestätigen";
"recovery.choose.neither" = "Ich habe keins von beidem";

/* Entering the code. The keyboard has no business helping here — this arrives by paste. */
"recovery.enter.title" = "Geben Sie Ihren Wiederherstellungscode ein";
"recovery.enter.message" = "Der Code, den wir Ihnen beim Einschalten des Backups gezeigt haben.";
