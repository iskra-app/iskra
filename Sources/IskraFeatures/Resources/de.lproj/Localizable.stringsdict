<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>roomList.reactions</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
				<key>one</key>
				<string>%lld neue Reaktion</string>
				<key>other</key>
				<string>%lld neue Reaktionen</string>
		</dict>
	</dict>
	<key>roomList.mentions</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
				<key>one</key>
				<string>%lld message mentioning you</string>
				<key>other</key>
				<string>%lld messages mentioning you</string>
		</dict>
	</dict>
	<key>room.participants</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
				<key>one</key>
				<string>%lld participant</string>
				<key>other</key>
				<string>%lld participants</string>
		</dict>
	</dict>
	<key>message.menu.reaction</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@, %2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
				<key>one</key>
				<string>%lld person</string>
				<key>other</key>
				<string>%lld people</string>
		</dict>
	</dict>
	<key>roomList.unread</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
				<key>one</key>
				<string>%lld unread</string>
				<key>other</key>
				<string>%lld unread</string>
		</dict>
	</dict>
	<key>message.menu.reactors</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
				<key>one</key>
				<string>%lld reaction</string>
				<key>other</key>
				<string>%lld reactions</string>
		</dict>
	</dict>
</dict>
</plist>
