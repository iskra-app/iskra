			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
				<key>one</key>
				<string>%lld участник</string>
				<key>few</key>
				<string>%lld участника</string>
				<key>many</key>
				<string>%lld участников</string>
				<key>other</key>
				<string>%lld участников</string>
		</dict>
	</dict>
	<key>message.menu.reaction</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@, %2$#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
				<key>one</key>
				<string>%lld человек</string>
				<key>few</key>
				<string>%lld человека</string>
				<key>many</key>
				<string>%lld человек</string>
				<key>other</key>
				<string>%lld человек</string>
		</dict>
	</dict>
	<key>roomList.unread</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
