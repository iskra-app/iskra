		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
				<key>one</key>
				<string>%lld реакция</string>
				<key>few</key>
				<string>%lld реакции</string>
				<key>many</key>
				<string>%lld реакций</string>
				<key>other</key>
