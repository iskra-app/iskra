/* Iskra — user-facing text.
   Edit the values, never the keys. The keys are referenced from Strings.swift.
   Language: es */

/* Device name shown in the user's list of signed-in devices. */
"device.generic" = "Iskra";

/* Device name shown in the user's list of signed-in devices. */
"device.iOS" = "Iskra en iPhone o iPad";

/* Device name shown in the user's list of signed-in devices. */
"device.mac" = "Iskra en Mac";

/* Summary line for an audio file in the chat list. */
"preview.audio" = "Audio";

/* Summary line for a message that was deleted. */
"preview.deleted" = "Mensaje eliminado";

/* Summary line for a file attachment in the chat list. */
"preview.file" = "Archivo";

/* Summary line for a shared location. */
"preview.location" = "Ubicación";

/* Summary line for a photo in the chat list. */
"preview.photo" = "Foto";

/* Summary line for a poll. */
"preview.poll" = "Encuesta";

/* Summary line for a sticker. */
"preview.sticker" = "Sticker";

/* Summary line for a message this device has no key for. Deliberately avoids the words 'decrypt' and 'key'. */
