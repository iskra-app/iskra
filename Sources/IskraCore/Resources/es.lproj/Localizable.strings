/* Summary line for a video in the chat list. */
"preview.video" = "Vídeo";

/* Summary line for a round video message. */
"preview.videoNote" = "Videomensaje";

/* Summary line for a voice message. */
"preview.voice" = "Mensaje de voz";

/* Says an unencrypted room is one, in three words. Read as a status, not as a warning. */
"privacy.notProtected" = "Este chat no está cifrado";

/* Says an encrypted room is one. Sits directly under the name, where it is read at a glance. */
"privacy.protected" = "Este chat está cifrado";

/* Shown before we have synced enough to know. Never claim protection we cannot see. */
"privacy.unknown" = "Comprobando el cifrado";

/* Fallback name for a conversation that has none. Most Matrix DMs have no name. */
"room.untitled" = "Chat";

/* Shown when a message could not be sent. The SDK retries, so this reassures rather than alarms. */
"timeline.sendFailed" = "El mensaje no se ha enviado. Lo volveremos a intentar automáticamente.";

/* A sticker that did not go. Unlike a message, it is not retried. */
"timeline.stickerFailed" = "El sticker no se ha enviado. Comprueba la conexión e inténtalo de nuevo.";

/* The account's sticker pack would not take a new sticker. */
"stickers.addFailed" = "No se ha podido añadir el sticker. Inténtalo de nuevo.";

/* The account's sticker pack would not let a sticker go. */
"stickers.removeFailed" = "No se ha podido quitar el sticker. Inténtalo de nuevo.";

/* Shown when an emoji reaction could not be sent. Must not say "message" — nothing the user wrote is at stake. */
"timeline.reactionFailed" = "La reacción no se ha enviado. Inténtalo de nuevo.";

/* Shown when deleting a message failed. Must be unambiguous: the message is still there, and everyone can still read it. */
"timeline.deleteFailed" = "El mensaje no se ha eliminado: sigue en el chat. Inténtalo de nuevo.";

/* Why a message is stuck, tapped from the badge beside it. Each names what to do next:
   the user is the only one who can clear these. No cryptography vocabulary. */
"sendFailure.insecureDevices" = "Alguien a quien verificaste ha iniciado sesión en un dispositivo que aún no ha confirmado. Si confías en ese dispositivo, envíalo de todos modos.";
"sendFailure.identityChanged" = "Las claves de cifrado de alguien a quien verificaste han cambiado. Si estás seguro de que sigue siendo la misma persona, envíalo de todos modos.";
"sendFailure.verificationRequired" = "Confirma este dispositivo para escribir en un chat protegido. Se hace en Ajustes.";
"sendFailure.missingMedia" = "El archivo ya no está en este dispositivo: no queda nada que enviar.";
"sendFailure.unsupportedFileType" = "Este tipo de archivo no se puede enviar.";
"sendFailure.server" = "Tu servidor no ha aceptado este mensaje.";

