/* Iskra — user-facing text.
   Edit the values, never the keys. The keys are referenced from Strings.swift.
   Language: ru */

/* Device name shown in the user's list of signed-in devices. */
"device.generic" = "Iskra";

/* Device name shown in the user's list of signed-in devices. */
"device.iOS" = "Iskra на iPhone или iPad";

/* Device name shown in the user's list of signed-in devices. */
"device.mac" = "Iskra на Mac";

/* Summary line for an audio file in the chat list. */
"preview.audio" = "Аудио";

/* Summary line for a message that was deleted. */
"preview.deleted" = "Сообщение удалено";

/* Summary line for a file attachment in the chat list. */
"preview.file" = "Файл";

/* Summary line for a shared location. */
"preview.location" = "Геопозиция";

/* Summary line for a photo in the chat list. */
"preview.photo" = "Фото";

/* Summary line for a poll. */
"preview.poll" = "Опрос";

/* Summary line for a sticker. */
"preview.sticker" = "Стикер";

/* Summary line for a message this device has no key for. Deliberately avoids the words 'decrypt' and 'key'. */
"preview.unreadable" = "Сообщение, которое пока не открыть";

/* Summary line for a video in the chat list. */
"preview.video" = "Видео";

/* Summary line for a round video message. */
"preview.videoNote" = "Видеосообщение";

/* Summary line for a voice message. */
"preview.voice" = "Голосовое сообщение";

/* Explains an unencrypted room. No cryptography vocabulary allowed. */
"privacy.notProtected" = "Здесь сообщения не защищены — сервер может их прочитать.";

/* Explains an encrypted room. No cryptography vocabulary allowed. */
"privacy.protected" = "Эти сообщения могут прочитать только участники чата. Даже мы не можем.";

/* Shown before we have synced enough to know. Never claim protection we cannot see. */
"privacy.unknown" = "Проверяем, защищён ли этот чат.";

/* Fallback name for a conversation that has none. Most Matrix DMs have no name. */
"room.untitled" = "Чат";

/* Shown when a message could not be sent. The SDK retries, so this reassures rather than alarms. */
"timeline.sendFailed" = "Сообщение не отправилось. Попробуем ещё раз автоматически.";

/* Shown when an emoji reaction could not be sent. Must not say "message" — nothing the user wrote is at stake. */
"timeline.reactionFailed" = "Реакция не отправилась. Попробуйте ещё раз.";

/* Shown when deleting a message failed. Must be unambiguous: the message is still there, and everyone can still read it. */
"timeline.deleteFailed" = "Сообщение не удалилось — оно всё ещё в чате. Попробуйте ещё раз.";

/* Why a message is stuck, tapped from the badge beside it. Each names what to do next:
   the user is the only one who can clear these. No cryptography vocabulary. */
"sendFailure.insecureDevices" = "Кто-то здесь вошёл с устройства, которое вы ещё не подтвердили. Подтвердите его — и сообщение уйдёт.";
"sendFailure.identityChanged" = "Кто-то в этом чате вошёл с нового места, и его личность изменилась. Убедитесь, что это правда он, — и сообщение уйдёт.";
"sendFailure.verificationRequired" = "Подтвердите это устройство, чтобы писать в защищённый чат. Это делается в настройках.";
"sendFailure.missingMedia" = "Файла больше нет на этом устройстве — отправлять нечего.";
"sendFailure.unsupportedFileType" = "Такие файлы отправлять нельзя.";
"sendFailure.server" = "Ваш сервер не принял это сообщение.";

/* The strip above a message that answers another one. */
"reply.loading" = "Загружаем сообщение…";
"reply.unavailable" = "Сообщение недоступно";

/* Shown when an edit could not be sent. The message still says the old thing — say so. */
"timeline.editFailed" = "Изменение не сохранилось — сообщение осталось прежним. Попробуйте ещё раз.";

/* Shown when pinning or unpinning was refused. */
"timeline.pinFailed" = "Не получилось изменить закреплённые сообщения. Возможно, у вас нет на это прав.";

/* The grey lines across a conversation: people coming and going, the room changing.
   Written so they are true of anybody: Matrix does not know anyone's gender, so
   "Аня вошла" is a coin flip on every name. Neutral phrasing sidesteps it entirely. */
"roomEvent.joined" = "%@ теперь в чате";
"roomEvent.left" = "%@ больше не в чате";
"roomEvent.invited" = "Пригласили: %@";
"roomEvent.removed" = "Исключили: %@";
"roomEvent.banned" = "Заблокировали: %@";
"roomEvent.renamedThemselves" = "%1$@ теперь %2$@";
"roomEvent.roomRenamed" = "Теперь чат называется «%@»";
"roomEvent.roomTopicChanged" = "Описание чата изменилось";
"roomEvent.roomPictureChanged" = "У чата новое фото";
"roomEvent.roomCreated" = "Чат создан";
"roomEvent.encryptionEnabled" = "Сообщения здесь защищены сквозным шифрованием";
"roomEvent.pair" = "%1$@ и %2$@";

/* What a client that cannot draw a map shows instead of one. */
"timeline.locationBody" = "Геопозиция: %1$.6f, %2$.6f";

/* Изменения комнаты, которых сервер не сделал. Каждое — своей фразой: «что-то пошло не
   так» не говорит человеку ничего, а «вас не пустили» говорит, что дело в правах и что
   в комнате всё осталось как было. */
"roomAction.renameFailed" = "Название не изменилось. Возможно, у вас нет на это прав.";
"roomAction.topicFailed" = "Описание не изменилось. Возможно, у вас нет на это прав.";
"roomAction.pictureFailed" = "Фото не изменилось. Возможно, у вас нет на это прав.";
"roomAction.visibilityFailed" = "Не получилось изменить, кто может войти в чат.";
"roomAction.inviteFailed" = "Не получилось пригласить. Проверьте адрес — он выглядит как @имя:сервер.";
"roomAction.removeFailed" = "Не получилось исключить. Человек остался в чате.";
"roomAction.banFailed" = "Не получилось заблокировать. Человек остался в чате.";
"roomAction.roleFailed" = "Роль не изменилась. Возможно, у вас нет на это прав.";
"roomAction.leaveFailed" = "Не получилось выйти из чата. Попробуйте ещё раз.";
