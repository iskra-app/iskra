/* Iskra — user-facing text.
   Edit the values, never the keys. The keys are referenced from Strings.swift.
   Language: en */

/* Device name shown in the user's list of signed-in devices. */
"device.generic" = "Iskra";

/* Device name shown in the user's list of signed-in devices. */
"device.iOS" = "Iskra on iPhone or iPad";

/* Device name shown in the user's list of signed-in devices. */
"device.mac" = "Iskra on Mac";

/* Summary line for an audio file in the chat list. */
"preview.audio" = "Audio";

/* Summary line for a message that was deleted. */
"preview.deleted" = "Message deleted";

/* Summary line for a file attachment in the chat list. */
"preview.file" = "File";

/* Summary line for a shared location. */
"preview.location" = "Location";

/* Summary line for a photo in the chat list. */
"preview.photo" = "Photo";

/* Summary line for a poll. */
"preview.poll" = "Poll";

/* Summary line for a sticker. */
"preview.sticker" = "Sticker";

/* Summary line for a message this device has no key for. Deliberately avoids the words 'decrypt' and 'key'. */
"preview.unreadable" = "Message you can’t read yet";

/* Summary line for a video in the chat list. */
"preview.video" = "Video";

/* Summary line for a round video message. */
"preview.videoNote" = "Video message";

/* Summary line for a voice message. */
"preview.voice" = "Voice message";

/* Says an unencrypted room is one, in three words. Read as a status, not as a warning. */
"privacy.notProtected" = "This chat isn’t encrypted";

/* Says an encrypted room is one. Sits directly under the name, where it is read at a glance. */
"privacy.protected" = "This chat is encrypted";

/* Shown before we have synced enough to know. Never claim protection we cannot see. */
"privacy.unknown" = "Checking encryption";

/* Fallback name for a conversation that has none. Most Matrix DMs have no name. */
"room.untitled" = "Chat";

/* Shown when a message could not be sent. The SDK retries, so this reassures rather than alarms. */
"timeline.sendFailed" = "Your message didn’t go through. It’ll try again automatically.";

/* A sticker that did not go. Unlike a message, it is not retried. */
"timeline.stickerFailed" = "The sticker didn’t go through. Check your connection and try again.";

/* The account's sticker pack would not take a new sticker. */
"stickers.addFailed" = "Couldn’t add the sticker. Please try again.";

/* The account's sticker pack would not let a sticker go. */
"stickers.removeFailed" = "Couldn’t remove the sticker. Please try again.";

/* Shown when an emoji reaction could not be sent. Must not say "message" — nothing the user wrote is at stake. */
"timeline.reactionFailed" = "Your reaction didn’t go through. Try again.";

/* Shown when deleting a message failed. Must be unambiguous: the message is still there, and everyone can still read it. */
"timeline.deleteFailed" = "The message couldn’t be deleted, so it’s still there. Try again.";

/* Why a message is stuck, tapped from the badge beside it. Each names what to do next:
   the user is the only one who can clear these. No cryptography vocabulary. */
"sendFailure.insecureDevices" = "Someone you verified is signed in on a device they haven’t confirmed yet. If you trust that device, send it anyway.";
"sendFailure.identityChanged" = "The encryption keys of someone you verified have changed. If you’re sure it’s still the same person, send it anyway.";
"sendFailure.verificationRequired" = "Verify this device before sending to a private chat. Open Settings to do it.";
"sendFailure.missingMedia" = "The file is no longer on this device, so there is nothing left to send.";
"sendFailure.unsupportedFileType" = "This kind of file can’t be sent.";
"sendFailure.server" = "Your server turned this message away.";

/* The Devices screen, when something did not work. */
"devices.loadFailed" = "Couldn’t load your devices. Check your connection and try again.";
"devices.endFailed" = "The session didn’t end. Try again.";
"devices.wrongPassword" = "That password didn’t work.";
"devices.managedElsewhere" = "On this server, sessions are ended on its website.";

/* The strip above a message that answers another one. */
"reply.loading" = "Loading the message…";
"reply.unavailable" = "Message unavailable";

/* Shown when an edit could not be sent. The message still says the old thing — say so. */
"timeline.editFailed" = "The change wasn’t saved, so the message still says what it did. Try again.";

/* Shown when pinning or unpinning was refused. */
"timeline.pinFailed" = "The pinned messages couldn’t be changed. You may not be allowed to.";
"timeline.reportFailed" = "The report didn’t go through. Try again.";
"timeline.pollFailed" = "That didn’t work — the poll is as it was. Try again.";
"timeline.pollEndedBody" = "The poll has ended";

/* The grey lines across a conversation: people coming and going, the room changing. */
"roomEvent.joined" = "%@ joined";
"roomEvent.left" = "%@ left";
"roomEvent.invited" = "Invited: %@";
"roomEvent.removed" = "Removed: %@";
"roomEvent.banned" = "Blocked: %@";
"roomEvent.renamedThemselves" = "%1$@ is now %2$@";
"roomEvent.roomRenamed" = "The chat is now called “%@”";
"roomEvent.roomTopicChanged" = "The chat description changed";
"roomEvent.roomPictureChanged" = "The chat has a new picture";
"roomEvent.roomCreated" = "The chat was created";
"roomEvent.encryptionEnabled" = "Encryption is on";
"roomEvent.pair" = "%1$@ and %2$@";

/* What a client that cannot draw a map shows instead of one. */
"timeline.locationBody" = "Location: %1$.6f, %2$.6f";

/* Changes to a room the homeserver would not make. One sentence each: "something went
   wrong" tells nobody anything, while "you weren't allowed to" says it was a question of
   rights and that the room is unchanged. */
"roomAction.renameFailed" = "The name didn’t change. You may not be allowed to.";
"roomAction.topicFailed" = "The description didn’t change. You may not be allowed to.";
"roomAction.pictureFailed" = "The picture didn’t change. You may not be allowed to.";
"roomAction.visibilityFailed" = "Who can join this chat couldn’t be changed.";
"roomAction.inviteFailed" = "The invitation didn’t go through. Check the address — it looks like @name:server.";
"roomAction.removeFailed" = "They couldn’t be removed. They are still in the chat.";
"roomAction.banFailed" = "They couldn’t be blocked. They are still in the chat.";
"roomAction.roleFailed" = "The role didn’t change. You may not be allowed to.";
"roomAction.rulesFailed" = "The permission didn’t change. You may not be allowed to.";
"roomAction.leaveFailed" = "You couldn’t leave the chat. Try again.";
"roomAction.createFailed" = "The chat wasn’t created. The server may not have answered — try again.";
"roomAction.joinAddressInvalid" = "A room address looks like #name:server or !id:server.";
"roomAction.joinFailed" = "Couldn’t join the room. It may not exist, may be closed, or the server didn’t answer.";
"roomAction.alertsFailed" = "This chat’s notifications didn’t change. Try again.";

/* The account: name, picture and encryption. */
"account.nameFailed" = "Your name didn’t change. Try again.";
"account.pictureFailed" = "Your picture didn’t change. Try again.";
"account.protectFailed" = "Your messages couldn’t be protected. Try again — the keys to your old messages are still where they were.";
"account.newKeyFailed" = "The new code wasn’t created. The old one still works.";
"account.restoreFailed" = "That code didn’t fit. Check you copied all of it, spaces and all.";
